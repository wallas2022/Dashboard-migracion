PORT=3100
DASHBOARD_MODE=demo

# SQL Server local
LOCAL_ENABLED=false
# Shared Memory es el transporte predeterminado cuando Node y SQL Server
# se ejecutan en el mismo equipo. Use TCP solo para conexiones remotas.
LOCAL_SQL_AUTH=windows
LOCAL_SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
LOCAL_SQL_SERVER=localhost
LOCAL_SQL_PORT=1434
LOCAL_SQL_DATABASE=master
LOCAL_SQL_ENCRYPT=false
LOCAL_SQL_TRUST_CERT=true
LOCAL_SQL_USE_TCP=false
LOCAL_SQL_TIMEOUT_MS=15000

# SQL Server KIO
KIO_SQL_SERVER=server_or_ip
KIO_SQL_PORT=1433
KIO_SQL_USER=dashboard_reader
KIO_SQL_PASSWORD=change_me
KIO_SQL_DATABASE=master
KIO_SQL_ENCRYPT=true
KIO_SQL_TRUST_CERT=true
KIO_SQL_TIMEOUT_MS=15000

# Huawei se habilita cuando exista
HUAWEI_ENABLED=false
HUAWEI_SQL_SERVER=
HUAWEI_SQL_PORT=1433
HUAWEI_SQL_USER=dashboard_reader
HUAWEI_SQL_PASSWORD=
HUAWEI_SQL_ENCRYPT=true
HUAWEI_SQL_TRUST_CERT=true
HUAWEI_SQL_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Pestaña Corte (valores de ejemplo; en QA apuntan a SQL63\MSSQLSERVER02 y SQL66)
CORTE_ENABLED=true
# SQL002 (réplica secundaria). Se conecta a master: las DMV del servidor se leen aunque la base sea secundaria no legible.
HUAWEI2_ENABLED=false
HUAWEI2_SQL_SERVER=10.22.0.11
HUAWEI2_SQL_PORT=1433
HUAWEI2_SQL_USER=dashboard_reader
HUAWEI2_SQL_PASSWORD=change_me
HUAWEI2_SQL_DATABASE=master
HUAWEI2_SQL_ENCRYPT=true
HUAWEI2_SQL_TRUST_CERT=true
HUAWEI2_SQL_TIMEOUT_MS=15000
# Balanceador NGINX: endpoint HTTP que sirve las últimas líneas del log de acceso (log_format corte) y stub_status
CORTE_BALANCER_HOST=10.22.0.18
CORTE_NGINX_LOG_URL=http://10.22.0.18:8081/corte_access.log
CORTE_NGINX_STATUS_URL=http://10.22.0.18/nginx_status
CORTE_NGINX_TLS_INSECURE=false
# Nodos web (WEB01,WEB02 en ese orden), sitios IIS nombre:puerto y Max Pool Size por aplicación
CORTE_WEB_NODES=10.22.0.35,10.22.0.34
CORTE_SITES=Controller-Portal-Admin:9090,Controller-Portal-Clientes:9091,Controller-Servicio-Soap:9092,Controller-Api:9093,API-V2:9095,RidersApi:9999,Controller-Internal-Services:3000
CORTE_POOL_MAX=Controller-Site:500,default:100
# Ventana (hora de Guatemala) y eventos hora=etiqueta|etiqueta corta del gráfico, en orden cronológico
CORTE_WINDOW_START=2026-11-13 20:00
CORTE_EVENTS=22:00=Detener KIO|Detener apps,23:00=Congelar y TRN puente|Puente,00:30=Tail-log,03:30=RECOVERY en Huawei|RECOVERY,07:00=Conectar WEB01/02|Conectar WEB,08:30=Pruebas,09:30=Go y operación|Go
# Umbrales de procesos lentos (s), sesión zombie (s inactiva), alerta de pool (%), historial (h), nombre de aplicación del monitor
CORTE_SLOW_AMBER_S=10
CORTE_SLOW_RED_S=30
CORTE_ZOMBIE_IDLE_S=60
CORTE_POOL_ALERT_PCT=80
CORTE_HISTORY_HOURS=48
CORTE_MONITOR_APP=TerraDashboardMonitor
# CPU de balanceador y WEB: URL de solo lectura en cada nodo que devuelve {"cpu": 38.5} (ver README)
CORTE_CPU_URLS=Balanceador=http://10.22.0.18:9100/cpu,WEB01=http://10.22.0.35:9100/cpu,WEB02=http://10.22.0.34:9100/cpu
