PORT=3100
DASHBOARD_MODE=demo

# SQL Server local
LOCAL_ENABLED=false
# Shared Memory es el transporte predeterminado cuando Node y SQL Server
# se ejecutan en el mismo equipo. Use TCP solo para conexiones remotas.
LOCAL_SQL_AUTH=windows
LOCAL_SQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
LOCAL_SQL_SERVER=localhost
LOCAL_SQL_PORT=1434
LOCAL_SQL_DATABASE=master
LOCAL_SQL_ENCRYPT=false
LOCAL_SQL_TRUST_CERT=true
LOCAL_SQL_USE_TCP=false
LOCAL_SQL_TIMEOUT_MS=15000

# SQL Server KIO
KIO_SQL_SERVER=server_or_ip
KIO_SQL_PORT=1433
KIO_SQL_USER=dashboard_reader
KIO_SQL_PASSWORD=change_me
KIO_SQL_DATABASE=master
KIO_SQL_ENCRYPT=true
KIO_SQL_TRUST_CERT=true
KIO_SQL_TIMEOUT_MS=15000

# Huawei se habilita cuando exista
HUAWEI_ENABLED=false
HUAWEI_SQL_SERVER=
HUAWEI_SQL_PORT=1433
HUAWEI_SQL_USER=dashboard_reader
HUAWEI_SQL_PASSWORD=
HUAWEI_SQL_ENCRYPT=true
HUAWEI_SQL_TRUST_CERT=true
HUAWEI_SQL_TIMEOUT_MS=15000
