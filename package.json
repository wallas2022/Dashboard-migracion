{
  "name": "terra-migration-dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspace web",
    "test": "npm run test --workspace server",
    "check": "npm run check --workspace server",
    "server": "npm run start --workspace server",
    "start": "npm run start --workspace server"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "msnodesqlv8@5.3.0": true
  }
}
